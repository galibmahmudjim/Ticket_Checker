{
  "name": "moviebot",
  "version": "1.0.0",
  "description": "Discord alert bot for Cineplex ticket availability",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx test/chainLease.mutualExclusion.test.ts && tsx test/guildSync.channelSelection.test.ts && tsx test/chainRunner.handoff.test.ts",
    "refresh-token": "tsx scripts/refreshToken.ts"
  },
  "dependencies": {
    "@vercel/functions": "^2.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^5.1.0",
    "playwright": "^1.46.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
