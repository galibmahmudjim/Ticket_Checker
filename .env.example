# Movie/date/location to watch is hardcoded in src/config.ts (MOVIE_ID/MOVIE_NAME/
# SHOW_DATE/LOCATION), not read from env.

# Bearer token for cineplexbd.com's movie-list API (NOT the ticket-api above — separate
# host, separate auth). Only used manually to look up the movie name when switching
# movies in src/config.ts. See CLAUDE.md "Movie name lookup token".
CINEPLEX_WEB_API_TOKEN=replace-with-bearer-token-from-devtools-on-cineplexbd.com

# Copy these from a browser DevTools request on ticket.cineplexbd.com
# (Network tab -> a get-shows request -> Request Headers)
CINEPLEX_DEVICE_KEY=replace-with-value-from-devtools
CINEPLEX_AUTH_TOKEN=replace-with-bearer-token-from-devtools

# Only change these if your captured request differs
CINEPLEX_APPSOURCE=web
CINEPLEX_AUTH_HEADER_NAME=Authorization
CINEPLEX_BASE_URL=https://cineplex-ticket-api.cineplexbd.com/api/v1

# Discord bot that will post alerts in a server channel (see CLAUDE.md "Discord alert
# setup" for full steps):
# 1. https://discord.com/developers/applications -> New Application -> Bot tab -> Reset Token -> copy it
# 2. OAuth2 -> URL Generator -> scope "bot" -> Bot Permissions: check View Channel and
#    Send Messages -> open the generated URL and add the bot to a server. A channel is
#    registered automatically: every poll reconciles the bot's guild list over
#    Discord's REST API and registers a postable channel per server — see
#    src/guildSync.ts. No manual channel configuration needed.
DISCORD_BOT_TOKEN=replace-with-bot-token-from-developer-portal

# Poll cadence (milliseconds)
POLL_INTERVAL_MS=60000

# Postgres connection string. Stores poll state (fingerprints, auth-alert flag),
# registered alert channels, and the poll-chain lease, in tables created automatically
# on first connect. On Vercel this MUST be a pooled endpoint (Neon pooler / Supabase
# pgbouncer port), since every warm function instance opens its own pool.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- HTTP poll endpoint only (see CLAUDE.md "Deployment: Vercel") ---
# Ignored by `npm run dev` / `npm start`, which use the in-process loop instead.

# Shared secret every caller of /api/poll must present as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
POLL_SECRET=replace-with-a-long-random-string

# How long one invocation holds the poll lock. Only needs to exceed the time a single
# poll takes; its real job is releasing the lock if an invocation dies mid-poll.
POLL_LOCK_TTL_MS=60000
